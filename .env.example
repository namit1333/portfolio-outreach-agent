# Copy to .env and fill in the providers you have. All are optional:
# with no keys at all the tool runs in --provider mock mode (offline demo).

# --- LLM provider (pick one; "auto" uses whichever key is present) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# --- Dedicated search API (optional; used with --search, or when the
#     LLM provider's built-in web search is unavailable) ---
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Defaults ---
OUTREACH_LIMIT=10
OUTREACH_CONCURRENCY=4
OUTREACH_MIN_SCORE=35
OUTREACH_OUT_ROOT=runs
